# Vysalytica API Configuration Template
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ============================================================================
# Database Configuration
# ============================================================================
# For development (SQLite - default):
DATABASE_URL=sqlite:///api/data/vysalytica.db

# For production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/vysalytica

# ============================================================================
# LLM Service Configuration
# Provide at least ONE of the following for fix generation and citations
# ============================================================================

# OpenAI (ChatGPT) - for citation checking and fix generation
OPENAI_API_KEY=sk-proj-...

# Anthropic (Claude) - for alternative citation checking
ANTHROPIC_API_KEY=sk-ant-...

# RouteLLM - LLM router service (optional, has defaults but should override)
# ROUTELLM_API_KEY=sk-...
# ROUTELLM_BASE_URL=https://api.abacus.ai/v1
# ROUTELLM_MODEL=gpt-3.5-turbo

# ============================================================================
# API & CORS Configuration
# ============================================================================

# Comma-separated list of allowed frontend origins
# For development: localhost origins only
# For production: specific domain(s) only
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# API base URL (used by Streamlit app and documentation)
API_BASE_URL=http://localhost:8080/api

# ============================================================================
# Rate Limiting Configuration
# ============================================================================

# Storage backend for rate limiter:
# - memory:// (default, single-process only)
# - redis://localhost:6379/0 (recommended for production)
LIMITER_STORAGE_URI=memory://

# ============================================================================
# Application Configuration
# ============================================================================

# Application version (for API responses)
APP_VERSION=0.1

# Debug mode (True for development, False for production)
DEBUG=True

# Environment identifier
ENV=dev

# ============================================================================
# Optional: Logging & Monitoring
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# ============================================================================
# Optional: Advanced Performance Tuning
# ============================================================================

# Robots.txt and sitemap.xml cache TTL in seconds
# ROBOTS_SITEMAP_CACHE_TTL_SECONDS=86400

# ============================================================================
# Notes for Developers
# ============================================================================
#
# 1. Minimum required for local development:
#    - DATABASE_URL (defaults to SQLite if not set)
#    - At least one LLM key for citation/fix features (optional for basic audits)
#
# 2. For production deployment:
#    - DATABASE_URL must point to PostgreSQL
#    - All LLM keys should be provided
#    - CORS_ALLOWED_ORIGINS must be restricted
#    - DEBUG must be False
#    - ENV must be "prod"
#    - LIMITER_STORAGE_URI should use Redis
#
# 3. Security:
#    - Never commit .env with real credentials
#    - Rotate API keys periodically
#    - Use environment-specific secrets in production
#
# 4. Testing:
#    Load with: export $(grep -v '^#' .env | xargs)
#    Or: set -a; source .env; set +a (bash)
#
